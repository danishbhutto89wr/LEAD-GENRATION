# ============================================
# .env.example — Netlify dashboard ke
# Site settings > Environment variables me
# ye sab values daalni hain (is file ko copy mat karo, seedha Netlify UI me daalo)
# ============================================

# --- Supabase (Project Settings > API se milega) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Anthropic (AI email personalization ke liye) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Gmail API (OAuth2) ---
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token_from_oauth_playground
GMAIL_SENDER_EMAIL=you@gmail.com

# --- App ---
PUBLIC_SITE_URL=https://your-app-name.netlify.app
